# копия в .env, секретов здесь нет
BOARD_NAME=EchoTracker
PORT=8100
ECHO_BASE=/echo/
WEB_PORT=5174
# занят — dev и сервер сами подберут свободный рядом
DATA_DIR=./data
UPLOADS_DIR=./uploads
# доки проекта рядом: echo/../../docs + README.md проекта
DOCS_DIR=../../docs
BASE_URL=http://127.0.0.1:8100/echo
WAITING_WARN_DAYS=3
OUTBOX_INTERVAL_MS=60000
# первый запуск: если пользователей нет, создаётся админ
ADMIN_LOGIN=
ADMIN_PASS=
ADMIN_EMAIL=
# SMTP заполняется в .env локально, пример:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_INSECURE=1 только для самоподписанного релея
SESSION_SECRET=change-me
